# Copy this file to .env and fill in your own values.
# Never commit your real .env file -- it contains secrets.

# --- Google Places API (New) ---
# https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=

# --- Search area for find_leads.py ---
# Defaults below = Iowa City, IA, ~5 mile radius. To search a different
# area, change these three values -- no code changes needed. See
# README.md for how to find lat/lng for a new city. Radius is in meters
# (8000 = ~5 miles, 16000 = ~10 miles).
SEARCH_CENTER_LAT=41.6611
SEARCH_CENTER_LNG=-91.5302
SEARCH_RADIUS_METERS=8000
# "bias" (soft preference, default) or "restriction" (hard cutoff -- see
# config.py for the difference).
SEARCH_LOCATION_MODE=bias

# --- Anthropic API (email drafting) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional override if the model id in generate_emails.py is ever renamed/retired.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Facebook Graph API (optional, used by find_emails.py) ---
# https://developers.facebook.com/ -- create an app, generate a token with
# pages_read_engagement (or a basic App Access Token for public Page Search).
# Leave blank to skip Facebook lookup entirely (all leads become phone_only).
FACEBOOK_ACCESS_TOKEN=

# --- Serper.dev (optional, used by find_emails.py) ---
# https://serper.dev -- sign up free (2,500 searches, one-time free
# allotment), then get your key from the dashboard. Used to discover a
# candidate domain for a lead via a real Google search when Facebook
# didn't provide one -- leave blank to skip domain discovery entirely.
SERPER_API_KEY=

# --- Hunter.io (optional, used by find_emails.py) ---
# https://hunter.io -- sign up free (25 searches/month on the free plan),
# then get your key from Dashboard -> API. Only useful for leads where a
# domain was found (via Facebook or Serper.dev above) -- leave blank to
# skip Hunter lookup entirely.
HUNTER_API_KEY=

# --- Sending: choose smtp, sendgrid, or mailgun ---
SEND_PROVIDER=smtp

# SMTP (e.g. Gmail with an App Password -- see README.md for setup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SendGrid (used only if SEND_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# Mailgun (used only if SEND_PROVIDER=mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# --- Common sender identity (required for every provider) ---
FROM_NAME=Your Name
FROM_EMAIL=you@example.com
REPLY_TO=you@example.com
# CAN-SPAM requires a real physical mailing address in every email.
MAILING_ADDRESS=123 Main St, Iowa City, IA 52240

# --- Rate limiting ---
DAILY_SEND_LIMIT=25
